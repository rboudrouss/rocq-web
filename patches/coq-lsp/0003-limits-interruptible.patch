diff --git a/coq/limits.ml b/coq/limits.ml
index 4d021a15..1b300c24 100644
--- a/coq/limits.ml
+++ b/coq/limits.ml
@@ -24,6 +24,10 @@ module type Intf = sig
   val available : bool
 end
 
+(* True while Coq.limit runs its function, which may then be interrupted
+   at any point (rocq-web raises Sys.Break from a Memprof callback) *)
+let interruptible = ref false
+
 module Coq : Intf = struct
   module Token : sig
     type t
@@ -49,7 +53,18 @@ module Coq : Intf = struct
     if Token.is_set token then Error Sys.Break
     else
       let () = Control.interrupt := false in
-      try Ok (f x) with Sys.Break -> Error Sys.Break
+      let outer = !interruptible in
+      interruptible := true;
+      match f x with
+      | r ->
+        interruptible := outer;
+        Ok r
+      | exception Sys.Break ->
+        interruptible := outer;
+        Error Sys.Break
+      | exception e ->
+        interruptible := outer;
+        raise e
 
   let name () = "Control.interrupt"
   let available = true
