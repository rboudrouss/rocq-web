diff --git a/coq/files.ml b/coq/files.ml
index 09522723..b1190b89 100644
--- a/coq/files.ml
+++ b/coq/files.ml
@@ -13,8 +13,17 @@ open Ppx_compare_lib.Builtin
 
 type t = int [@@deriving hash, compare]
 
-let make () = 0
-let bump i = i + 1
+(* The latest version: a document opened after the files changed starts
+   from it, not from 0, whose Require results are memoized with the old
+   files *)
+let current = ref 0
+let make () = !current
+
+let bump i =
+  current := max !current i + 1;
+  !current
+
+let changed () = incr current
 let hash = Int.hash
 let compare = Int.compare
 let pp = Format.pp_print_int
